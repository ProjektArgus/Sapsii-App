# Server-only dashboard API access. Never prefix these with NEXT_PUBLIC_.
SAPSII_API_URL=http://localhost:3001
# Local demo fallback only. Production uses the Supabase cookie session below.
SAPSII_API_BEARER_TOKEN=
# Server-side Supabase Auth endpoint and browser-safe publishable key.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=
# Required when one identity belongs to more than one organization.
SAPSII_ORGANIZATION_ID=
# minLongitude,minLatitude,maxLongitude,maxLatitude; each span must be <= 5 degrees.
SAPSII_DEFAULT_BBOX=76.32,30.28,76.46,30.40

# Browser-visible key for the CARTO vector basemap used by MapLibre GL JS.
NEXT_PUBLIC_CARTO_API_KEY=
