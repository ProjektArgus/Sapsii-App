# Standard process configuration; no hosting-provider variables are required.
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL connection string supplied by the selected database host.
DATABASE_URL=postgresql://sapsii:change-me@localhost:5432/sapsii
DATABASE_MAX_CONNECTIONS=10
DEVICE_OFFLINE_AFTER_SECONDS=45

# Optional generic OIDC configuration for authenticated dashboard routes.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Local demo only: base64url-encoded public JWK served by `npm run demo:oidc`.
DEMO_OIDC_PUBLIC_JWK_BASE64=

# Optional S3-compatible private object storage (AWS S3, MinIO, R2, etc.).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
