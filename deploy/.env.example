# Copy to /etc/sapsii/sapsii.env and chmod 600. Never commit the populated file.
SAPSII_IMAGE_TAG=replace-with-successful-main-commit-sha
SAPSII_API_IMAGE=ghcr.io/projektargus/sapsii-api
SAPSII_UI_IMAGE=ghcr.io/projektargus/sapsii-ui

# Single public hostname. Paths: / -> dashboard, /api -> Sapsii API,
# /platform -> Supabase. The admin hostname serves Supabase Studio.
ARGUS_PUBLIC_HOST=argus.imxone.com
ARGUS_ADMIN_HOST=argus-admin.imxone.com
SAPSII_ORGANIZATION_SLUG=sapsii-dev
SAPSII_ORGANIZATION_ID=
SAPSII_DEFAULT_BBOX=76.32,30.28,76.46,30.40

# Sapsii uses its own database inside the Supabase PostgreSQL cluster.
# URL-encode special characters in the password.
SAPSII_DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://sapsii:replace-with-url-encoded-password@db:5432/sapsii
DATABASE_MAX_CONNECTIONS=10
DEVICE_OFFLINE_AFTER_SECONDS=45
LOG_LEVEL=info

# Supabase Auth validates human dashboard sessions; Sapseed devices continue
# using Sapsii Device credentials. These must match SUPABASE_PUBLIC_URL and
# API_EXTERNAL_URL in the Supabase stack.
OIDC_ISSUER=https://argus.imxone.com/platform/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://argus.imxone.com/platform/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=replace-from-supabase-env

# Supabase Storage S3 protocol. These mirror S3_PROTOCOL_ACCESS_KEY_* in the
# official Supabase .env. The endpoint is intentionally not under /platform:
# SigV4 signs the request path, so a prefix-stripping route would break every
# presigned upload with SignatureDoesNotMatch.
S3_BUCKET=evidence
S3_REGION=stub
S3_ENDPOINT=https://argus.imxone.com/storage/v1/s3
S3_ACCESS_KEY_ID=replace-from-supabase-env
S3_SECRET_ACCESS_KEY=replace-from-supabase-env

# Used by the outbound deploy poller. The repository is public, so the only
# reason a token is needed is that the GHCR packages are private. GitHub
# Packages accepts personal access tokens (classic) only - fine-grained tokens
# cannot authenticate to ghcr.io. The single required scope is read:packages.
# Authorise the token for ProjektArgus if the organisation enforces SAML SSO.
GITHUB_REPOSITORY=ProjektArgus/Sapsii-App
GITHUB_WORKFLOW_FILE=publish-images.yml
GH_TOKEN=replace-with-a-classic-pat-scoped-read-packages
# The GitHub account that owns GH_TOKEN; ghcr.io authenticates against it.
GHCR_USERNAME=replace-with-your-github-username
