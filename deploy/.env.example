# Copy to /etc/sapsii/sapsii.env and chmod 600. Never commit the populated file.
SAPSII_IMAGE_TAG=replace-with-successful-main-commit-sha
SAPSII_API_IMAGE=ghcr.io/projektargus/sapsii-api
SAPSII_UI_IMAGE=ghcr.io/projektargus/sapsii-ui

SAPSII_PUBLIC_HOST=sapsii.imxone.com
SAPSII_ADMIN_HOST=sapsii-admin.imxone.com
SAPSII_ORGANIZATION_SLUG=sapsii-dev
SAPSII_ORGANIZATION_ID=
SAPSII_DEFAULT_BBOX=76.32,30.28,76.46,30.40

# Sapsii uses its own database inside the Supabase PostgreSQL cluster.
# URL-encode special characters in the password.
SAPSII_DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://sapsii:replace-with-url-encoded-password@db:5432/sapsii
DATABASE_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Supabase Auth validates human dashboard sessions; Sapseed devices continue
# using Sapsii Device credentials.
OIDC_ISSUER=https://sapsii.imxone.com/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://sapsii.imxone.com/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=replace-from-supabase-env

# Supabase Storage S3 protocol. These mirror S3_PROTOCOL_ACCESS_KEY_* in the
# official Supabase .env.
S3_BUCKET=evidence
S3_REGION=stub
S3_ENDPOINT=https://sapsii.imxone.com/storage/v1/s3
S3_ACCESS_KEY_ID=replace-from-supabase-env
S3_SECRET_ACCESS_KEY=replace-from-supabase-env

# Used by the outbound deploy poller for a private GitHub repository. A
# fine-grained read-only token needs Actions read and Packages read.
GITHUB_REPOSITORY=ProjektArgus/Sapsii-App
GITHUB_WORKFLOW_FILE=publish-images.yml
GH_TOKEN=replace-with-read-only-token
