[Unit]
Description=Restrict Sapsii ingress to the Gateway LXC
Before=docker.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/nft delete table inet sapsii 2>/dev/null || true; /usr/sbin/nft -f /etc/sapsii/sapsii-filter.nft'
ExecReload=/bin/sh -c '/usr/sbin/nft delete table inet sapsii 2>/dev/null || true; /usr/sbin/nft -f /etc/sapsii/sapsii-filter.nft'
ExecStop=-/usr/sbin/nft delete table inet sapsii

[Install]
WantedBy=multi-user.target
