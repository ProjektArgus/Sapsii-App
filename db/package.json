{
  "name": "@sapsii/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "clear:test-data": "tsx --env-file-if-exists=.env src/clear-test-data.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/seed-demo.ts",
    "simulate:demo": "tsx --env-file-if-exists=.env src/simulate-demo.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
